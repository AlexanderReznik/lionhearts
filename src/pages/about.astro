---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import { SITE_URL } from '../data/club';
import missionPhoto from '../assets/mission/allan_training_blue.jpg';
import womensSquad from '../assets/heritage/womens_squad.jpg';
import mensSquad from '../assets/heritage/mens_squad.jpg';
import bowlingSocial from '../assets/heritage/bowling_social.jpg';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'London Lionhearts Volleyball Club',
  url: SITE_URL,
  foundingDate: '1998',
  founder: { '@type': 'Person', name: 'Alvin Spencer' },
  sport: 'Volleyball',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gosset Street',
    addressLocality: 'London',
    postalCode: 'E2 6NW',
    addressCountry: 'GB',
  },
};

// Our Values — Allan's copy (slides 40–41). `icon` names a glyph from the
// designer's brand icon set (see Icon.astro).
const valuesIntro =
  "We're a friendly local club — community comes first, on and off the court.";

const values: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'inclusivity',
    title: 'Inclusivity',
    body: 'We act as catalysts for change for a truly inclusive society by promoting safe, accessible and fair participation, and inspiring physical activity for all.',
  },
  {
    icon: 'respect',
    title: 'Respect',
    body: 'We value and celebrate unique and diverse talents, experiences and perspectives. We treat our participants, partners, donors, and each other with sensitivity and respect.',
  },
  {
    icon: 'collaboration',
    title: 'Collaboration',
    body: 'We work and win together, individually and collectively, as distinct and diverse individuals.',
  },
];

// Mission — Allan's copy, split into a lead statement + a bolded call to action.
const missionLead =
  'To develop, promote growth and increase the quality of volleyball for everyone within our community.';
const missionStatement =
  'Together, we can create positive opportunities that generate sustainable societal change.';

// Heritage photos from the club archive (designer's set, shots 8 / 4 / 2).
const heritagePhotos = [
  {
    image: womensSquad,
    alt: "Lionhearts women's squad and coaches in blue kit, posed on court after a match",
  },
  {
    image: mensSquad,
    alt: "Lionhearts men's squad in navy and red kit, posed in front of the net on an arena court",
  },
  {
    image: bowlingSocial,
    alt: 'Lionhearts players clowning around on the lanes at a club bowling social',
  },
];
---

<BaseLayout
  title="About the Club — Volleyball in Shoreditch Since 1998"
  description="Founded in 1998 by Alvin Spencer, London Lionhearts Volleyball Club has been Shoreditch's home for volleyball for over 25 years. 9× LVA Women's Champions, NVL Super League club."
  jsonLd={orgSchema}
>
  <div class="page-hero">
    <Eyebrow class="page-hero__eyebrow" text="London Lionhearts · Since 1998" />
    <h1 class="page-hero__title">About <em>Us</em></h1>
    <p class="page-hero__sub">
      The story of Shoreditch's volleyball club — 25+ years of community, competition,
      and players from 25+ countries.
    </p>
  </div>

  <section class="about-history page-content">
    <div class="about-history__inner">
      <PhotoCarousel photos={heritagePhotos} label="Club heritage photos" />

      <div class="about-history__story">
        <Eyebrow text="Est. 1998 · Shoreditch, East London" />
        <h2 class="about-history__headline">
          From community club to the <em>Super League</em>.
        </h2>

        <div class="about-history__chips">
          <div class="about-history__chip">
            <strong>Alvin Spencer</strong>
            <span>Founder, 1998</span>
          </div>
          <div class="about-history__chip">
            <strong>Allan Mungroo</strong>
            <span>Club Director, since 2008</span>
          </div>
        </div>

        <p>
          Founded in 1998 by Alvin Spencer, Lionhearts began as a small community club in
          Shoreditch. Over 25 years it has become 9× LVA Women's Champions,
          an NVL Super League club, and a community that draws players from
          every corner of the world.
        </p>
        <p>
          Since 2008, Allan Mungroo has led the club through its most successful era, building
          not just competitive teams but a place where newcomers to London find their footing,
          expats find community, and beginners find their sport.
        </p>

        <a href="/join" class="btn btn--primary about-history__cta">
          Join the Community →
        </a>
      </div>
    </div>

  </section>

  <!-- Values band — dark feature surface; copy from Allan (slides 40–41) -->
  <section class="about-values section--feature">
    <div class="about-values__inner container">
      <div class="about-values__lede">
        <Eyebrow class="about-values__eyebrow" text="Our Values" as="h2" />
        <p class="about-values__intro">{valuesIntro}</p>
      </div>
      <ul class="values-list" role="list">
        {values.map(v => (
          <li class="value-card">
            <span class="value-card__icon" aria-hidden="true">
              <Icon name={v.icon} />
            </span>
            <span class="value-card__text">
              <h3 class="value-card__title">{v.title}</h3>
              <span class="value-card__body">{v.body}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Mission band — full-bleed navy-duotone training photo -->
  <section class="about-mission section--feature">
    <div class="about-mission__media" aria-hidden="true">
      <Picture
        src={missionPhoto}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        alt=""
        loading="lazy"
      />
    </div>
    <div class="about-mission__inner container">
      <Eyebrow class="about-mission__eyebrow" text="Our Mission" as="h2" />
      <p class="about-mission__lead">{missionLead}</p>
      <p class="about-mission__statement">{missionStatement}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-history__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .about-history__headline {
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    margin-bottom: 20px;
    line-height: var(--leading-none);
  }

  .about-history__headline em { color: var(--color-accent-text); font-style: normal; }

  .about-history__chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .about-history__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(84,164,247,0.10);
    border: 1px solid var(--color-border-blue);
    border-radius: 6px;
    padding: 7px 14px;
  }

  .about-history__chip strong { font-size: var(--text-note); font-weight: var(--weight-bold); }
  .about-history__chip span { font-size: var(--text-eyebrow); color: var(--color-text-muted); }

  .about-history__cta { margin-top: 1.5rem; }

  .about-history__story p {
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-loose);
    margin-bottom: 12px;
  }

  /* Values — dark feature band. Intro lede on the left, a vertical stack of
     icon+text cards on the right (mirrors the brand deck, slides 40–41). */
  .about-values { padding: 72px var(--page-px); }
  .about-values__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 48px 56px;
    align-items: start;
  }

  .about-values__eyebrow { margin-bottom: 20px; }
  .about-values__intro {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-text);
    max-width: 18ch;
  }

  .values-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .value-card {
    display: flex;
    align-items: center;
    gap: 28px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 28px 32px;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .value-card:hover {
    border-color: var(--color-border-blue);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-2px);
  }

  /* Large decorative brand glyph — sits above the type scale, no token exists
     at this display size. */
  .value-card__icon { font-size: 5.25rem; color: var(--color-accent-text); line-height: 1; flex: none; }
  .value-card__text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .value-card__title { font-size: var(--text-lg); font-weight: var(--weight-black); text-transform: uppercase; letter-spacing: var(--tracking-display); line-height: var(--leading-none); }
  .value-card__body { font-size: var(--text-body); color: var(--color-text-muted); line-height: var(--leading-relaxed); }

  /* Mission — full-bleed band behind a navy-duotone training photo. The base
     gradient shows while the photo loads; the ::after overlay keeps text AA
     over the photo's bright upper half. */
  .about-mission {
    position: relative;
    padding: clamp(72px, 12vw, 140px) var(--page-px);
    overflow: hidden;
    isolation: isolate;
  }
  .about-mission__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(140deg, var(--lh-navy), var(--lh-navy-deep));
  }
  /* Focal point sits low in the portrait frame — the coach's shoulders and the
     court behind him, not the roof trusses. */
  .about-mission__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }
  .about-mission__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5, 18, 43, 0.6), rgba(5, 18, 43, 0.86));
  }
  .about-mission__eyebrow { margin-bottom: 28px; }
  .about-mission__lead,
  .about-mission__statement {
    font-size: var(--text-sub);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-display);
  }
  .about-mission__lead {
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
    margin-bottom: 32px;
  }
  .about-mission__statement { font-weight: var(--weight-black); color: var(--color-text); }

  @media (max-width: 768px) {
    .about-history__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .about-history__headline {
      line-height: var(--leading-display);
    }

    .about-values { padding: 52px var(--page-px); }
    .about-values__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .about-values__intro { max-width: none; }

    .value-card { gap: 20px; padding: 24px; }
    .value-card__icon { font-size: 3.25rem; }

    .about-mission__lead { font-size: var(--text-xl); }
  }

  /* Below ~365px the long "Collaboration" title can't sit beside the icon at
     full size — tighten the icon, gap and title just enough to keep the word
     alongside the icon (never stacked below it). */
  @media (max-width: 364px) {
    .value-card { gap: 16px; padding: 20px; }
    .value-card__icon { font-size: 3rem; }
    .value-card__title { font-size: var(--text-lead); }
  }
</style>
