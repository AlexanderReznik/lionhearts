---
import BaseLayout from '../layouts/BaseLayout.astro';
import TryoutsSection from '../components/TryoutsSection.astro';
import SessionCard from '../components/SessionCard.astro';
import VenueCard from '../components/VenueCard.astro';
import SessionsFallbackNotice from '../components/SessionsFallbackNotice.astro';
import Eyebrow from '../components/Eyebrow.astro';
import openSession1 from '../assets/sessions/open_session_1.jpg';
import openSession2 from '../assets/sessions/open_session_2.jpg';
import openSession3 from '../assets/sessions/open_session_3.jpg';
import juniorBall from '../assets/sessions/junior_ball.jpg';
import { getSessions, getJuniorSessions, parseSessionSchedule, nextOccurrences, tryoutOccurrence, parsePriceGBP, getUpcomingTryouts, type Session } from '../lib/sheets';
import { SITE_URL } from '../data/club';

// ── Google Sheets integration ──────────────────────────────────────────────
// Set GOOGLE_SHEET_ID in your environment or Netlify/Vercel env vars.
// The sheet must be published (File → Share → Publish to web → CSV).
// Columns: day, time, level, venue, price.
// See human-todo.md item 8 for the full webhook setup that triggers a
// rebuild whenever the sheet is edited.
// ─────────────────────────────────────────────────────────────────────────
const { sessions, usingFallback } = await getSessions(import.meta.env.GOOGLE_SHEET_ID);
// Tile count = sessions + the venue tile; drives the responsive grid columns.
const tileCount = sessions.length + 1;

// Session-tile backgrounds: each open-session card gets its own photo (cycled
// by index so extra sessions still get a background); juniors share one.
const openPhotos = [openSession1, openSession2, openSession3];

// Junior sessions live on a separate tab of the same sheet — set
// GOOGLE_JUNIORS_GID to its gid. day + time only (no level/venue tile).
const { sessions: juniorSessions, usingFallback: juniorsFallback } =
  await getJuniorSessions(import.meta.env.GOOGLE_SHEET_ID, import.meta.env.GOOGLE_JUNIORS_GID);

// Pre-season tryouts — dedicated tab (GOOGLE_TRYOUTS_GID). Empty array = nothing
// renders (no fallback), so the section self-hides outside tryout season.
const tryouts = await getUpcomingTryouts(import.meta.env.GOOGLE_SHEET_ID, import.meta.env.GOOGLE_TRYOUTS_GID);

// ── JSON-LD: Recurring events with Schedule type ───────────────────────────
const VENUE = {
  '@type': 'Place',
  name: 'Mulberry Academy Shoreditch',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Gosset Street',
    addressLocality: 'London',
    postalCode: 'E2 6NW',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 51.527392,
    longitude: -0.069586,
  },
};

const ORGANIZER = {
  '@type': 'SportsOrganization',
  name: 'London Lionhearts Volleyball Club',
  url: SITE_URL,
};

// Derived from the live session data (single source of truth) so the
// structured data can never drift from the schedule shown on the page.
// Google's Event rich results require a concrete `startDate`, so instead of a
// single Schedule-based Event per session we expand each weekly session into
// its next few dated occurrences (nextOccurrences). Sessions whose day/time
// can't be parsed are skipped rather than emitted as invalid Events. Because
// the dates are computed at build time, they stay fresh only if the site is
// rebuilt regularly (the sheet-edit webhook + periodic deploys cover this).
const OCCURRENCES_AHEAD = 6;

// Recommended (non-required) Event fields. `image` reuses the site's stable
// social-preview photo (absolute URL, no asset hashing needed). `offers` is
// built from the session's door price — omitted when the cell has no £ amount
// so we never emit a bogus price. `performer` is intentionally NOT set: an open
// training session has participants, not an act an audience watches, so that
// field doesn't apply.
const EVENT_IMAGE = `${SITE_URL}/images/og-default.jpg`;

function offerFor(s: Session) {
  const price = parsePriceGBP(s.price);
  if (!price) return {};
  return {
    offers: {
      '@type': 'Offer',
      price,
      priceCurrency: 'GBP',
      availability: 'https://schema.org/InStock',
      url: `${SITE_URL}/sessions`,
    },
  };
}

function sessionEvents(list: typeof sessions, name: (s: Session) => string, description: (s: Session) => string) {
  return list.flatMap(s => {
    const schedule = parseSessionSchedule(s);
    if (!schedule) return [];
    return nextOccurrences(schedule, OCCURRENCES_AHEAD).map(occ => ({
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: name(s),
      description: description(s),
      image: EVENT_IMAGE,
      startDate: occ.startDate,
      endDate: occ.endDate,
      location: VENUE,
      organizer: ORGANIZER,
      ...offerFor(s),
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    }));
  });
}

// Tryouts are one-off dated events, so each maps straight to a single Event.
// The full VENUE block (with address + geo) applies only when the tryout is at
// the usual venue; elsewhere we emit a name-only Place. The registration form,
// when present, becomes the Event `url`. No `offers` — a tryout isn't a paid
// drop-in, and `performer` is omitted for the same reason as the sessions.
const tryoutSchemas = tryouts.flatMap(t => {
  const occ = tryoutOccurrence(t);
  if (!occ) return [];
  return [{
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: `London Lionhearts — ${t.team ? `${t.team} ` : ''}Tryout`,
    description: `Volleyball tryout${t.team ? ` for ${t.team}` : ''} at ${t.venue}.`,
    image: EVENT_IMAGE,
    startDate: occ.startDate,
    endDate: occ.endDate,
    location: t.venue === VENUE.name ? VENUE : { '@type': 'Place', name: t.venue },
    organizer: ORGANIZER,
    ...(t.form ? { url: t.form } : {}),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  }];
});

const eventSchemas = [
  ...sessionEvents(
    sessions,
    s => `London Lionhearts — Open Training (${s.level})`,
    s => `Open volleyball session at ${s.venue} — ${s.level}. No booking required.`,
  ),
  ...sessionEvents(
    juniorSessions,
    () => 'London Lionhearts — Junior Volleyball',
    s => `Junior volleyball session at ${s.venue}. New juniors always welcome.`,
  ),
  ...tryoutSchemas,
];
---

<BaseLayout
  title="Volleyball Sessions — Shoreditch E2"
  description="Open volleyball sessions for adults and juniors at Mulberry Academy, Shoreditch E2. No booking, no commitment — every level welcome, every week."
  jsonLd={eventSchemas}
>
  <div class="page-hero">
    <Eyebrow class="page-hero__eyebrow" text="Mulberry Academy · Shoreditch E2" />
    <h1 class="page-hero__title">Volleyball<br /><em>Sessions</em></h1>
    <p class="page-hero__sub">
      Open sessions for adults and juniors every week — no booking, no commitment. Just turn up and play.
    </p>
  </div>

  <div class="page-content">

    <TryoutsSection tryouts={tryouts} />

    <section class="sessions-box" aria-labelledby="sessions-heading">
      <header class="section-head">
        <h2 class="section-head__title" id="sessions-heading">Open <em>Sessions</em></h2>
        <p class="section-head__sub">Beginner-friendly volleyball — just turn up and play, every level welcome, every week.</p>
      </header>

      {usingFallback && <SessionsFallbackNotice schedule="weekly schedule" />}

      <div class={`session-cards session-cards--${tileCount}`}>
        {sessions.map((s, i) => <SessionCard session={s} photo={openPhotos[i % openPhotos.length]} />)}
        <VenueCard />
      </div>
    </section>

    <hr class="section-divider" />

    <section class="sessions-box" aria-labelledby="juniors-heading">
      <header class="section-head">
        <h2 class="section-head__title" id="juniors-heading">Junior <em>Sessions</em></h2>
        <p class="section-head__sub">Volleyball for our younger players. New juniors always welcome.</p>
      </header>

      {juniorsFallback && <SessionsFallbackNotice schedule="junior schedule" />}

      <div class="junior-cards">
        {juniorSessions.map(s => <SessionCard session={s} photo={juniorBall} />)}
        <VenueCard />
      </div>
    </section>

  </div>

</BaseLayout>

<style>
  /* ── Sessions box ── */
  /* S31: no boxed background — the Open Sessions block aligns with the rest of
     the page hierarchy; the eyebrow heading + cards carry the section on their own. */
  .sessions-box {
    margin-bottom: 36px;
  }

  .section-head { margin-bottom: 20px; }
  .section-head__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }
  .section-head__title em { color: var(--color-accent-text); font-style: normal; }
  .section-head__sub {
    margin-top: 6px;
    max-width: 66ch;
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }

  .section-divider {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 16px 0 36px;
  }

  /* Columns track the tile count (sessions + venue). Shrinking, even counts
     fold to a balanced 2-up grid and odd counts collapse straight to a single
     column — so we never land on an orphaned row (no 3+1 / 2+1). */
  .session-cards {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(4, 1fr);   /* fallback */
  }

  .session-cards--2 { grid-template-columns: repeat(2, 1fr); }
  .session-cards--3 { grid-template-columns: repeat(3, 1fr); }
  .session-cards--4 { grid-template-columns: repeat(4, 1fr); }
  .session-cards--5 { grid-template-columns: repeat(5, 1fr); }

  @media (max-width: 900px) {
    .session-cards--5 { grid-template-columns: 1fr; }       /* 5: no clean fold → stack */
  }

  @media (max-width: 820px) {
    .session-cards--4 { grid-template-columns: repeat(2, 1fr); }   /* 4 → 2×2 */
  }

  @media (max-width: 620px) {
    .session-cards--3 { grid-template-columns: 1fr; }       /* 3 → stack (avoids 2+1) */
  }

  @media (max-width: 420px) {
    .session-cards--2,
    .session-cards--4 { grid-template-columns: 1fr; }       /* final fold to single column */
  }

  /* Junior cards — mirror the adult 4-tile grid's column structure and
     breakpoints so a junior tile is exactly the same width as an open-session
     tile. The juniors row carries its own venue tile (same venue), so the
     session card stretches to match it — no hardcoded height needed. */
  .junior-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  @media (max-width: 820px) {
    .junior-cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 420px) {
    .junior-cards { grid-template-columns: 1fr; }
  }

</style>
