---
import Icon from './Icon.astro';

const baubles = [
  { colour: 'blue', delay: 'a' },
  { colour: 'white', delay: 'b' },
  { colour: 'red', delay: 'c' },
];
---

<style is:inline>
  .christmas-baubles {
    --christmas-ball: 34px;
    --christmas-inset: 0px;
    --christmas-edge: max(var(--page-px), calc((100% - var(--max-width)) / 2 + var(--page-px)));
    /* longest string + cap + ball + 12px clearance, minus Footer's 52px top padding */
    height: 38px;
    pointer-events: none;
  }
  .christmas-bauble {
    position: absolute;
    top: 0;
    width: var(--christmas-ball);
    right: calc(var(--christmas-edge) - var(--christmas-ball) / 2 + var(--christmas-inset) + var(--christmas-i) * 48px);
    transform-origin: 50% 0;
    animation: christmas-sway 3.6s ease-in-out infinite alternate;
    pointer-events: none;
    z-index: 5;
  }
  .christmas-bauble::before {
    content: '';
    display: block;
    width: 1px;
    height: var(--christmas-string);
    margin: 0 auto;
    background: light-dark(rgb(17 35 75 / 0.4), rgb(255 255 255 / 0.6));
  }
  .christmas-bauble__cap {
    display: block;
    width: 6px;
    height: 4px;
    margin: 0 auto;
    border-radius: 1px;
    background: var(--lh-grey-400);
  }
  .christmas-bauble__ball {
    display: block;
    width: var(--christmas-ball);
    height: var(--christmas-ball);
    font-size: var(--christmas-ball);
    line-height: 0;
    border-radius: 50%;
    background: var(--christmas-seam);
    color: var(--christmas-panel);
  }
  .christmas-bauble--blue {
    --christmas-i: 0;
    --christmas-string: 16px;
    --christmas-panel: var(--lh-blue);
    --christmas-seam: var(--lh-white);
  }
  .christmas-bauble--white {
    --christmas-i: 1;
    --christmas-string: 40px;
    --christmas-panel: var(--lh-white);
    --christmas-seam: var(--lh-navy);
  }
  .christmas-bauble--red {
    --christmas-i: 2;
    --christmas-string: 26px;
    --christmas-panel: var(--lh-red);
    --christmas-seam: var(--lh-white);
  }
  .christmas-bauble--d-a { animation-delay: -0.6s; }
  .christmas-bauble--d-b { animation-delay: -1.8s; }
  .christmas-bauble--d-c { animation-delay: -3s; }
  @keyframes christmas-sway {
    from { transform: rotate(-5deg); }
    to { transform: rotate(5deg); }
  }
  @media (max-width: 768px) {
    .christmas-baubles {
      --christmas-ball: 30px;
      --christmas-inset: 4px;
      height: 22px;
    }
    .christmas-bauble--blue { --christmas-string: 10px; }
    .christmas-bauble--white { --christmas-string: 28px; }
    .christmas-bauble--red { --christmas-string: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .christmas-bauble { animation: none; }
  }
  @media print {
    .christmas-baubles { display: none; }
  }
</style>

<div class="christmas-baubles" aria-hidden="true">
  {baubles.map((b) => (
    <div class={`christmas-bauble christmas-bauble--${b.colour} christmas-bauble--d-${b.delay}`}>
      <span class="christmas-bauble__cap"></span>
      <span class="christmas-bauble__ball"><Icon name="session" /></span>
    </div>
  ))}
</div>
