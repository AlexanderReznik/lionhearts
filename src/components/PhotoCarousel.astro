---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Photo {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  photos: Photo[];
  label: string;
  sizes?: string;
}

const { photos, label, sizes = '(max-width: 768px) 100vw, 540px' } = Astro.props;
---

{photos.length > 0 && (
  <div
    class="photo-carousel"
    role="group"
    aria-roledescription="carousel"
    aria-label={label}
    data-photo-carousel
  >
    <p class="sr-only" aria-live="polite"></p>

    {photos.map((photo, i) => (
      <div
        class:list={['photo-carousel__slide', { 'photo-carousel__slide--active': i === 0 }]}
        role="group"
        aria-roledescription="slide"
        aria-label={`Photo ${i + 1} of ${photos.length}`}
      >
        <Picture
          src={photo.image}
          formats={['avif', 'webp']}
          widths={[400, 540, 640, 800, 960]}
          sizes={sizes}
          alt={photo.alt}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}

    {photos.length > 1 && (
      <>
        <div class="photo-carousel__scrim" aria-hidden="true"></div>

        <button
          class="photo-carousel__arrow photo-carousel__arrow--prev"
          type="button"
          aria-label="Previous photo"
        >
          <span aria-hidden="true">←</span>
        </button>
        <button
          class="photo-carousel__arrow photo-carousel__arrow--next"
          type="button"
          aria-label="Next photo"
        >
          <span aria-hidden="true">→</span>
        </button>

        <div class="photo-carousel__dots">
          {photos.map((_, i) => (
            <button
              class:list={['photo-carousel__dot', { 'photo-carousel__dot--active': i === 0 }]}
              type="button"
              aria-label={`Show photo ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
              data-slide={i}
            />
          ))}
        </div>
      </>
    )}
  </div>
)}

<style>
  /* Crossfading photo frame — same slide mechanics and dot vocabulary as the
     homepage Hero, sized to the slot it fills rather than the viewport. 4:3 at
     every width — it's the photos' native ratio, so the squads never get
     cropped mid-group on a narrow screen. */
  .photo-carousel {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: linear-gradient(160deg, var(--color-surface-2), var(--color-surface));
  }

  .photo-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .photo-carousel__slide--active { opacity: 1; }

  .photo-carousel__slide :global(picture),
  .photo-carousel__slide :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Keeps the dots legible over a light patch of photo, mirroring the hero's
     bottom-up overlay at frame scale. */
  .photo-carousel__scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    pointer-events: none;
    background: linear-gradient(to top, rgba(5,18,43,0.65), rgba(5,18,43,0));
  }

  /* Over-photo chrome stays theme-independent (navy scrim + white glyph), like
     .hero__location — a semantic surface token would disappear on the photo. */
  .photo-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 50%;
    background: rgba(5,18,43,0.55);
    color: var(--lh-white);
    font-size: var(--text-lead);
    line-height: var(--leading-none);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .photo-carousel__arrow:hover {
    background: rgba(5,18,43,0.8);
    border-color: var(--color-accent);
  }

  .photo-carousel__arrow:active { transform: translateY(-50%) scale(0.96); }

  .photo-carousel__arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .photo-carousel__arrow--prev { left: 12px; }
  .photo-carousel__arrow--next { right: 12px; }

  .photo-carousel__dots {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
  }

  .photo-carousel__dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255,255,255,0.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: width 0.25s, background 0.25s, border-radius 0.25s;
  }

  /* A 6px dot is far too small to tap — grow the hit area to ~16×30 without
     changing the mark. The inset matches half the row gap, so neighbouring
     targets meet but never overlap. */
  .photo-carousel__dot::after {
    content: '';
    position: absolute;
    inset: -12px -5px;
  }

  .photo-carousel__dot--active {
    width: 24px;
    border-radius: 3px;
    background: var(--color-accent);
  }

  .photo-carousel__dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-carousel__slide { transition: none; }
  }

  /* Arrows tuck closer to the frame edge on the narrowest screens so they don't
     sit over the group in the crop. */
  @media (max-width: 480px) {
    .photo-carousel__arrow--prev { left: 8px; }
    .photo-carousel__arrow--next { right: 8px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach(root => {
    const slides = root.querySelectorAll<HTMLElement>('.photo-carousel__slide');
    const dots   = root.querySelectorAll<HTMLButtonElement>('.photo-carousel__dot');
    const status = root.querySelector<HTMLElement>('[aria-live]');

    if (slides.length < 2) return;

    let current = 0;

    function goTo(n: number): void {
      slides[current].classList.remove('photo-carousel__slide--active');
      dots[current].classList.remove('photo-carousel__dot--active');
      dots[current].setAttribute('aria-current', 'false');

      current = (n + slides.length) % slides.length;

      slides[current].classList.add('photo-carousel__slide--active');
      dots[current].classList.add('photo-carousel__dot--active');
      dots[current].setAttribute('aria-current', 'true');

      if (status) status.textContent = `Photo ${current + 1} of ${slides.length}`;
    }

    root.querySelector('.photo-carousel__arrow--prev')
      ?.addEventListener('click', () => goTo(current - 1));
    root.querySelector('.photo-carousel__arrow--next')
      ?.addEventListener('click', () => goTo(current + 1));

    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft')  goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });
  });
</script>
