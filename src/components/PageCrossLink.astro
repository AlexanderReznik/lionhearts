---
interface Props {
  text: string;
  label: string;
  href: string;
}
const { text, label, href } = Astro.props;
---

<aside class="crosslink">
  <p class="crosslink__text">{text}</p>
  <a class="crosslink__link" href={href}>{label} →</a>
</aside>

<style>
  .crosslink {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }

  .crosslink__text {
    color: var(--color-text-muted);
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
  }

  .crosslink__link {
    color: var(--color-accent-text);
    font-size: var(--text-note);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  .crosslink__link:hover { text-decoration: underline; }

  .crosslink__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
