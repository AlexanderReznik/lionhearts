---
const WIDTH = 3000;
const s = 26;
const sag = s / 2;
const bulbW = 10;
const bulbH = 15;
const hangY = 0.625 + 0.375 * (1 + sag);
const height = Math.ceil(hangY + bulbH + 2);

let wire = `M0 1 Q ${s} ${1 + sag} ${2 * s} 1`;
for (let x = 4 * s; x <= WIDTH + 2 * s; x += 2 * s) wire += ` T ${x} 1`;

const colours = ['blue', 'red', 'green', 'white'];
const bulbs = Array.from({ length: Math.ceil(WIDTH / s) }, (_, i) => ({
  x: s / 2 + i * s - bulbW / 2,
  colour: colours[i % 4],
  delay: (i + 2) % 4,
}));
---

<div class="christmas-lights" aria-hidden="true">
  <div class="christmas-lights__strip">
    <svg width={WIDTH} height={height} viewBox={`0 0 ${WIDTH} ${height}`} focusable="false">
      <symbol id="christmas-bulb" viewBox="-5 0 10 15">
        <rect class="christmas-bulb__cap" x="-1.8" y="0" width="3.6" height="3" rx=".7"></rect>
        <ellipse cx="0" cy="8.6" rx="3.5" ry="5.6" fill="currentColor"></ellipse>
      </symbol>
      <path class="christmas-lights__wire" d={wire}></path>
      {bulbs.map((b) => (
        <use
          href="#christmas-bulb"
          x={b.x}
          y={hangY - 1.5}
          width={bulbW}
          height={bulbH}
          class={`christmas-bulb christmas-bulb--${b.colour} christmas-bulb--d${b.delay}`}
        ></use>
      ))}
    </svg>
  </div>
</div>

<style is:inline>
  .christmas-lights {
    position: relative;
    height: 0;
    z-index: 5;
  }
  .christmas-lights__strip {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .christmas-lights__strip svg {
    display: block;
    max-width: none;
  }
  .christmas-lights__wire {
    fill: none;
    stroke: var(--lh-slate);
    stroke-width: 1.1;
  }
  .christmas-bulb__cap {
    fill: var(--lh-grey-400);
  }
  .christmas-bulb {
    animation: christmas-twinkle 1.6s ease-in-out infinite alternate;
    filter: drop-shadow(0 0 2px currentColor);
  }
  .christmas-bulb--blue { color: var(--lh-blue); }
  .christmas-bulb--red { color: var(--lh-red); }
  .christmas-bulb--green { color: var(--lh-green); }
  .christmas-bulb--white {
    color: var(--lh-white);
    stroke: light-dark(rgb(17 35 75 / 0.3), transparent);
    stroke-width: 0.8;
  }
  .christmas-bulb--white .christmas-bulb__cap {
    stroke: none;
  }
  .christmas-bulb--d0 { animation-delay: -0.0s; }
  .christmas-bulb--d1 { animation-delay: -0.4s; }
  .christmas-bulb--d2 { animation-delay: -0.8s; }
  .christmas-bulb--d3 { animation-delay: -1.2s; }
  @keyframes christmas-twinkle {
    from { opacity: 0.5; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .christmas-bulb {
      animation: none;
      opacity: 1;
    }
  }
  @media print {
    .christmas-lights { display: none; }
  }
</style>
