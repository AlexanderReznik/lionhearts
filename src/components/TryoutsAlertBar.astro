---
// src/components/TryoutsAlertBar.astro
// Slim homepage teaser bar, shown below the nav and above the hero. Renders
// nothing when there are no upcoming tryouts.
import type { Tryout } from '../lib/sheets';

interface Props { tryouts: Tryout[]; }
const { tryouts } = Astro.props;
---

{tryouts.length > 0 && (
  <aside class="tryouts-bar" aria-label="Tryouts announcement">
    <div class="tryouts-bar__inner container">
      <span class="tryouts-bar__lead">
        <span class="tryouts-bar__dot" aria-hidden="true"></span>
        <strong class="tryouts-bar__title">Tryouts now open</strong>
      </span>
      <span class="tryouts-bar__text">Secure your spot for the new season</span>
      <a href="/events#tryouts" class="tryouts-bar__link">See Dates &amp; Sign Up →</a>
    </div>
  </aside>
)}

<style>
  /* Inverted band: dark navy strip on the white page in light theme; in dark
     theme it flips to a light strip on the navy page, keeping the same
     stand-out contrast. Title/link go deep-blue there (AA on white) while the
     dot's bright blue still reads on white. light-dark() follows color-scheme,
     so no-JS users on OS dark get the flip too. */
  .tryouts-bar {
    background: light-dark(var(--lh-navy), var(--lh-white));
    color: light-dark(var(--lh-white), var(--lh-navy));
  }

  .tryouts-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px 14px;
    padding: 10px var(--page-px);
    flex-wrap: wrap;
  }

  /* Dot + "Tryouts now open" stay together as one unit (line 1 when stacked). */
  .tryouts-bar__lead {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .tryouts-bar__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--lh-blue);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--lh-blue) 25%, transparent);
    flex-shrink: 0;
  }

  .tryouts-bar__title {
    font-size: var(--text-body-sm);
    font-weight: var(--weight-extrabold);
    color: light-dark(var(--lh-blue), var(--lh-blue-deep));
  }

  .tryouts-bar__text {
    font-size: var(--text-note);
    font-weight: var(--weight-semibold);
  }

  .tryouts-bar__link {
    font-size: var(--text-eyebrow);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: light-dark(var(--lh-blue), var(--lh-blue-deep));
    text-decoration: none;
    white-space: nowrap;
  }
  .tryouts-bar__link:hover { text-decoration: underline; }
  .tryouts-bar__link:focus-visible {
    outline: 2px solid light-dark(var(--lh-blue), var(--lh-blue-deep));
    outline-offset: 3px;
  }

  /* Narrow screens: stack into three centred lines —
     1) dot + "Tryouts now open"  2) the sentence  3) the link. */
  @media (max-width: 560px) {
    .tryouts-bar__inner {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
