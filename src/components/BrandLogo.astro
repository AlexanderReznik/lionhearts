---
// src/components/BrandLogo.astro
// Renders an official mark. Navy variant on light theme, white on dark.
// variant="main" = full wordmark (default); variant="submark" = compact crest.
interface Props {
  class?: string;
  width?: number;
  height?: number;
  variant?: 'main' | 'submark';
}
const { class: className, width = 132, height = 48, variant = 'main' } = Astro.props;
const base = variant === 'submark' ? '/brand/logo-submark-base.svg' : '/brand/logo-main-base.svg';
const onDark = variant === 'submark' ? '/brand/logo-submark.svg' : '/brand/logo-main.svg';
---
<span class:list={['brand-logo', className]}>
  <img class="brand-logo__img brand-logo__img--light"
       src={base} alt="London Lionhearts Volleyball Club"
       width={width} height={height} />
  <img class="brand-logo__img brand-logo__img--dark"
       src={onDark} alt="London Lionhearts Volleyball Club" loading="lazy"
       width={width} height={height} />
</span>

<style>
  .brand-logo { display: inline-flex; line-height: 0; }
  .brand-logo__img { display: block; height: auto; }
  /* Default (light theme): show navy/base, hide white. `display` can't use
     light-dark(), so key the swap on data-theme and mirror the no-JS
     OS-preference guard from global.css — otherwise a no-JS dark user gets
     the navy logo on the navy background. */
  .brand-logo__img--dark { display: none; }
  :global(html[data-theme="dark"]) .brand-logo__img--light { display: none; }
  :global(html[data-theme="dark"]) .brand-logo__img--dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme="light"])) .brand-logo__img--light { display: none; }
    :global(html:not([data-theme="light"])) .brand-logo__img--dark { display: block; }
  }
</style>
